{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "jpet-cloud",
  "account_id": "507f35340f4c1062376b79dbbb011ce6",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-04",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "s.jpet.powerlive.io", "custom_domain": true }],
  "vars": { "AI_DAILY_TOKEN_LIMIT": 2000000, "AI_ENABLED": "false" },
  "durable_objects": {
    "bindings": [{ "name": "PLAYERS", "class_name": "Player" }, { "name": "AI_ACCOUNTS", "class_name": "AiAccount" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Player"] }, { "tag": "v2", "new_sqlite_classes": ["AiAccount"] }],
  "d1_databases": [{
    "binding": "RANK",
    "database_name": "jpet-rank",
    "database_id": "27fb48bb-efed-4428-8c22-9bc89ab5298c",
    "migrations_dir": "migrations"
  }],
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "head_sampling_rate": 1 },
    "traces": { "enabled": true, "head_sampling_rate": 0.01 }
  }
}
